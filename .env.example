# =============================================================================
# Crésus — variables d'environnement
# Copie ce fichier en .env.local (dev) ou configure-les dans Vercel (prod).
# NE COMMITE JAMAIS de vraies clés — .env* est ignoré par git.
# Tant qu'une source n'a pas ses clés, l'app tourne en mode démo / estimé.
# =============================================================================

# --- Accès / sécurité --------------------------------------------------------
# Protège TOUT le site (pages + API) par mot de passe. Laisser vide = site ouvert.
# Dès qu'un mot de passe est mis ici, une page de login apparaît.
APP_PASSWORD=

# --- Reporting ---------------------------------------------------------------
REPORTING_CURRENCY=EUR
REPORT_TZ=Europe/Paris
# Taux de change en direct (BCE via frankfurter.app). 1 = activé, sinon taux figés.
FX_API=1
# Source des coûts pour la marge (anti double-comptage) :
#   connectors = coûts granulaires (POD + Meta) dans la marge, Pennylane/Qonto en rapprochement (défaut)
#   pennylane  = charges comptabilisées Pennylane dans la marge, connecteurs en repère
COST_BASIS=connectors

# --- Hypothèses de coûts (utilisées tant que le POD n'est pas branché) -------
ESTIMATED_COGS_RATE=0.28          # coût de prod estimé, en fraction du CA HT
ESTIMATED_FULFILLMENT_RATE=0.06   # expédition estimée, en fraction du CA HT
PAYMENT_FEE_RATE=0.029            # frais passerelle, fraction du CA TTC
PAYMENT_FEE_FIXED=0.30            # frais fixes par commande (devise de reporting)
CORPORATE_TAX_RATE=0.25           # taux IS pour la projection

# --- Shopify (CA, commandes, TVA) --------------------------------------------
# Admin API access token d'une app custom (scopes: read_orders).
SHOPIFY_SHOP=arte-collective.myshopify.com
SHOPIFY_ADMIN_TOKEN=

# --- Printify (coût POD + expédition) ----------------------------------------
PRINTIFY_API_TOKEN=
PRINTIFY_SHOP_ID=                 # optionnel, sinon la 1re boutique du compte

# --- Prodigi (coût POD + expédition) -----------------------------------------
PRODIGI_API_KEY=
# PRODIGI_BASE=https://api.prodigi.com/v4.0   # sandbox: https://api.sandbox.prodigi.com/v4.0

# --- Artelo (coût POD) --------------------------------------------------------
# Token généré depuis Artelo > Integrations. Doc : https://www.artelo.io/artelo-api
# ⚠️ URL de base + noms de champs coût à confirmer (voir src/lib/connectors/artelo.ts).
ARTELO_API_KEY=
# ARTELO_BASE=https://api.artelo.io/v1

# --- Qonto (flux bancaires réels) --------------------------------------------
QONTO_LOGIN=
QONTO_SECRET_KEY=
# QONTO_IBAN=                     # optionnel : cible un compte précis
# QONTO_IGNORE_LABELS=shopify,stripe   # évite de recompter le CA encaissé

# --- Pennylane (compta / rapprochement) --------------------------------------
# API v2, scope supplier_invoices:readonly. Base : app.pennylane.com/api/external/v2
PENNYLANE_API_TOKEN=
# PENNYLANE_BASE=https://app.pennylane.com/api/external/v2

# --- Meta Ads (dépense pub) --------------------------------------------------
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=act_XXXXXXXXXX
# META_API_VERSION=v21.0
